{
  "name": "camberstack-mcp",
  "version": "0.32.0",
  "description": "Google Ads, Search Console, Google Analytics 4, Merchant Center and Tag Manager in one MCP server: build Search, Performance Max, Display and YouTube (Demand Gen) campaigns, research keywords, fix Shopping products and conversion tracking, and make only the changes you approve.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/stdio.js",
    "start:http": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@sentry/node": "^10.76.2",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "homepage": "https://camberstack.io",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-ads",
    "google-ads-mcp",
    "ppc",
    "claude",
    "chatgpt",
    "negative-keywords",
    "search-console",
    "google-analytics",
    "ga4",
    "merchant-center",
    "google-shopping",
    "mcp-server",
    "google-search-console",
    "google-ads-api",
    "gsc",
    "gmc",
    "google-tag-manager",
    "gtm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zwznco/camberstack-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/zwznco/camberstack-mcp/issues"
  }
}
